import OrderObstruction

/-! Native records on a two-direction lattice.

Each occupied cell performs a single atomic update. Its variable inputs are its
local write/control and the states physically forwarded by its two immediate
predecessors. The fixed boundary state supplies a missing predecessor. -/
namespace AASCLocalAudit

set_option autoImplicit false
abbrev Site := ℕ × ℕ
abbrev Rule (I S : Type*) := Site → I → S → S → S

variable {I S : Type*}

/-- Shifted indexing keeps the empty west and south boundaries explicit. -/
def run (b : S) (rule : Rule I S) (w : Site → I) : ℕ → ℕ → S
  | 0, _ => b
  | _ + 1, 0 => b
  | x + 1, y + 1 => rule (x,y) (w (x,y)) (run b rule w x (y+1)) (run b rule w (x+1) y)
termination_by x y => x + y

def reading (b : S) (rule : Rule I S) (w : Site → I) (p : Site) : S :=
  run b rule w (p.1+1) (p.2+1)

private theorem run_cone (b : S) (rule : Rule I S) (u v : Site → I) (x y : ℕ)
    (same : ∀ i < x, ∀ j < y, u (i,j) = v (i,j)) :
    run b rule u x y = run b rule v x y := by
  induction x generalizing y with
  | zero => simp [run]
  | succ x west =>
    induction y with
    | zero => simp [run]
    | succ y south =>
      rw [run, run]
      rw [same x (by omega) y (by omega)]
      rw [west (y+1) (fun i hi j hj => same i (by omega) j hj)]
      rw [south (fun i hi j hj => same i hi j (by omega))]

/-- Covers every possible site-dependent control, internal state, write, readout
or simultaneous log that belongs to this local update alphabet. -/
theorem past_determines_reading (b : S) (rule : Rule I S) (u v : Site → I) (q : Site)
    (same : ∀ p ≤ q, u p = v p) : reading b rule u q = reading b rule v q :=
  run_cone _ _ _ _ _ _ (fun i hi j hj => same (i,j) ⟨by omega, by omega⟩)

def Influence (b : S) (rule : Rule I S) (p q : Site) : Prop :=
  ∃ u v : Site → I, (∀ k ≠ p, u k = v k) ∧ reading b rule u q ≠ reading b rule v q

theorem influence_within_cone (b : S) (rule : Rule I S) (p q : Site) :
    Influence b rule p q → p ≤ q := by
  rintro ⟨u,v,elsewhere,changed⟩
  by_contra outside
  exact changed (past_determines_reading _ _ _ _ _ (fun k hk =>
    elsewhere k (fun h => outside (h ▸ hk))))

/-- Each entry records the local operand, the actual intervention or control,
and the resulting state. The coordinate distinguishes equal payloads re-created
at different original events. The state alphabet may itself be a product. -/
abbrev Entry (I S : Type*) := Site × I × S
abbrev WithLog (I S : Type*) := S × Finset (Entry I S)

variable [DecidableEq I] [DecidableEq S]

def archiveRule (rule : Rule I S) : Rule I (WithLog I S) := fun p i west south =>
  let observed := rule p i west.1 south.1
  (observed, insert (p,i,observed) (west.2 ∪ south.2))

private theorem run_projects (b : S) (r : Rule I S) (w : Site → I) (x y : ℕ) :
    (run (b,∅) (archiveRule r) w x y).1 = run b r w x y := by
  induction x generalizing y with
  | zero => simp [run]
  | succ x west =>
    induction y with
    | zero => simp [run]
    | succ y south =>
      rw [run, run]
      simp only [archiveRule, west, south]

theorem archive_projects (b : S) (r : Rule I S) (w : Site → I) (p : Site) :
    (reading (b,∅) (archiveRule r) w p).1 = reading b r w p :=
  run_projects _ _ _ _ _

private theorem run_contains (b : S) (r : Rule I S) (w : Site → I) (k : Site) (i : I) (s : S)
    (x y : ℕ) : (k,i,s) ∈ (run (b,∅) (archiveRule r) w x y).2 ↔
      k.1 < x ∧ k.2 < y ∧ i = w k ∧ s = reading b r w k := by
  induction x generalizing y with
  | zero => simp [run]
  | succ x west =>
    induction y with
    | zero => simp [run]
    | succ y south =>
      have localStep : r (x,y) (w (x,y)) (run b r w x (y+1)) (run b r w (x+1) y) =
          reading b r w (x,y) := by
        unfold reading
        exact (run.eq_3 ..).symm
      rw [run]
      simp only [archiveRule, Finset.mem_insert, Finset.mem_union, run_projects,
        localStep, west, south, Prod.mk.injEq]
      constructor
      · rintro (⟨rfl, rfl, rfl⟩ | ⟨hx,hy,hi,hs⟩ | ⟨hx,hy,hi,hs⟩)
        · exact ⟨by simp,by simp,rfl,rfl⟩
        · exact ⟨by omega,hy,hi,hs⟩
        · exact ⟨hx,by omega,hi,hs⟩
      · rintro ⟨hx,hy,hi,hs⟩
        by_cases earlierX : k.1 < x
        · exact Or.inr (Or.inl ⟨earlierX,hy,hi,hs⟩)
        by_cases earlierY : k.2 < y
        · exact Or.inr (Or.inr ⟨hx,earlierY,hi,hs⟩)
        have atCell : k = (x,y) := Prod.ext (by dsimp; omega) (by dsimp; omega)
        exact Or.inl ⟨atCell,atCell ▸ hi,atCell ▸ hs⟩

/-- The actual cell archive contains exactly the original local entries in its
causal past. It is generated by the two physical transmissions above. -/
theorem original_entry_in_archive (b : S) (r : Rule I S) (w : Site → I)
    (p q : Site) (i : I) (s : S) :
    (p,i,s) ∈ (reading (b,∅) (archiveRule r) w q).2 ↔
      p ≤ q ∧ i = w p ∧ s = reading b r w p := by
  rw [reading, run_contains]
  constructor
  · rintro ⟨hx,hy,hi,hs⟩
    exact ⟨⟨by omega,by omega⟩,hi,hs⟩
  · rintro ⟨⟨hx,hy⟩,hi,hs⟩
    exact ⟨by omega,by omega,hi,hs⟩

/-- A receiving apparatus can check the recorded input at a specified occurrence
by inspecting only its own finite archive. A reconstruction or repair policy may
use this Boolean as an input. -/
def readsWrite (p : Site) (i : I) (buffer : WithLog I S) : Bool :=
  decide ((p,i) ∈ buffer.2.image (fun entry => (entry.1, entry.2.1)))

theorem reads_write_exactly (b : S) (r : Rule I S) (w : Site → I)
    (p q : Site) (i : I) :
    readsWrite p i (reading (b,∅) (archiveRule r) w q) = true ↔ p ≤ q ∧ i = w p := by
  simp only [readsWrite, decide_eq_true_eq, Finset.mem_image]
  constructor
  · rintro ⟨⟨k,j,s⟩,entry,eq⟩
    change (k,j) = (p,i) at eq
    cases eq
    exact ⟨((original_entry_in_archive ..).mp entry).1,
      ((original_entry_in_archive ..).mp entry).2.1⟩
  · rintro ⟨prev,rfl⟩
    exact ⟨(p,w p,reading b r w p),(original_entry_in_archive ..).mpr ⟨prev,rfl,rfl⟩,rfl⟩

/-- Even with identical fresh symbols later on, changing only the original
write at p flips this physically local yes/no decision at every strict future q. -/
theorem earlier_write_decides_later_read (b : S) (r : Rule I S) (u v : Site → I)
    {p q : Site} (future : p < q) (different : u p ≠ v p) :
    readsWrite p (u p) (reading (b,∅) (archiveRule r) u q) = true ∧
    readsWrite p (u p) (reading (b,∅) (archiveRule r) v q) = false := by
  constructor
  · exact (reads_write_exactly ..).mpr ⟨future.le,rfl⟩
  · cases h : readsWrite p (u p) (reading (b,∅) (archiveRule r) v q) with
    | false => rfl
    | true => exact (different ((reads_write_exactly ..).mp h).2).elim

theorem entries_retained (b : S) (r : Rule I S) (w : Site → I)
    {p q : Site} (future : p ≤ q) :
    (reading (b,∅) (archiveRule r) w p).2 ⊆ (reading (b,∅) (archiveRule r) w q).2 := by
  rintro ⟨k,i,s⟩ mem
  rw [original_entry_in_archive] at mem ⊢
  exact ⟨mem.1.trans future,mem.2⟩

/-- At a later native cell, a finite local filter reconstructs the earlier
cell's entire archive, including the control and state at each original event. -/
theorem earlier_archive_from_later (b : S) (r : Rule I S) (w : Site → I)
    {p q : Site} (future : p ≤ q) :
    (reading (b,∅) (archiveRule r) w p).2 =
      (reading (b,∅) (archiveRule r) w q).2.filter (fun entry => entry.1 ≤ p) := by
  ext ⟨k,i,s⟩
  rw [Finset.mem_filter, original_entry_in_archive, original_entry_in_archive]
  exact ⟨fun h => ⟨⟨h.1.trans future,h.2⟩,h.1⟩, fun h => ⟨h.2,h.1.2⟩⟩

theorem archived_influence_iff_product (b : S) (r : Rule I S) (zero one : I)
    (distinct : zero ≠ one) (p q : Site) : Influence (b,∅) (archiveRule r) p q ↔ p ≤ q := by
  constructor
  · exact influence_within_cone _ _ _ _
  · intro future
    let u : Site → I := fun _ => zero
    let v : Site → I := fun k => if k = p then one else zero
    refine ⟨u,v,fun k different => by simp [u,v,different],?_⟩
    have present := (original_entry_in_archive b r u p q zero (reading b r u p)).mpr
      ⟨future,rfl,rfl⟩
    intro equal
    rw [equal] at present
    have payload := ((original_entry_in_archive ..).mp present).2.1
    exact distinct (by simpa [v] using payload)

theorem archived_influence_excludes_six_events (b : S) (r : Rule I S) (zero one : I)
    (distinct : zero ≠ one) (a d : Fin 3 → Site) :
    ¬ ∀ i j, Influence (b,∅) (archiveRule r) (a i) (d j) ↔ i ≠ j := by
  intro pattern
  apply AASCOrderObstruction.two_orders_exclude_three_diagonals a d
  intro i j
  exact (archived_influence_iff_product b r zero one distinct _ _).symm.trans (pattern i j)

theorem archival_extension_preserves_possible_influence (b : S) (r : Rule I S)
    (zero one : I) (distinct : zero ≠ one)
    (transparent : ∀ p q : Site, p ≤ q → Influence b r p q) (p q : Site) :
    Influence (b,∅) (archiveRule r) p q ↔ Influence b r p q := by
  rw [archived_influence_iff_product b r zero one distinct]
  exact ⟨transparent p q, influence_within_cone b r p q⟩

end AASCLocalAudit
