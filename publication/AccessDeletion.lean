import Mathlib.Data.Finset.Card
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic

/-! A deletion test for complete common-future observations, and a sufficient
order-theoretic construction from three lower covers of a single event. -/
namespace AASCAccessDeletion

variable {S E : Type*}

def Six (r : S → E → Prop) : Prop :=
  ∃ a : Fin 3 → S, ∃ b : Fin 3 → E, ∀ i j, r (a i) (b j) ↔ i ≠ j

def Common (r : S → E → Prop) (F : Finset S) (y : E) : Prop :=
  ∀ x ∈ F, r x y

def Generates (r : S → E → Prop) (F G : Finset S) : Prop :=
  ∀ y, Common r F y ↔ Common r G y

def PairBasis (r : S → E → Prop) : Prop :=
  ∀ F : Finset S, ∃ G : Finset S, G ⊆ F ∧ G.card ≤ 2 ∧ Generates r F G

private theorem six_from_rows {r : S → E → Prop} {a b c : S} {u v w : E}
    (hu : ¬ r a u) (hub : r b u) (huc : r c u)
    (hv : ¬ r b v) (hva : r a v) (hvc : r c v)
    (hw : ¬ r c w) (hwa : r a w) (hwb : r b w) : Six r := by
  refine ⟨![a, b, c], ![u, v, w], ?_⟩
  intro i j
  fin_cases i <;> fin_cases j <;> simp_all

private theorem essential_at {r : S → E → Prop} [DecidableEq S]
    {F : Finset S} {x : S} (h : ¬ Generates r F (F.erase x)) :
    ∃ y, ¬ r x y ∧ Common r (F.erase x) y := by
  classical
  by_contra! hn
  apply h
  intro y
  constructor
  · exact fun old z hz => old z (Finset.mem_of_mem_erase hz)
  · intro rest z hz
    by_cases he : z = x
    · subst z
      by_contra missing
      exact hn y missing rest
    · exact rest z (Finset.mem_erase.mpr ⟨he, hz⟩)

/-- A failure of two-launch sufficiency on even one finite experiment forces
the three excluded launches and their native receiver witnesses. -/
theorem pair_basis_of_no_six {r : S → E → Prop} (none : ¬ Six r) : PairBasis r := by
  classical
  intro F
  let P := fun k : ℕ => ∃ G : Finset S, G ⊆ F ∧ G.card = k ∧ Generates r F G
  have existsP : ∃ k, P k := ⟨F.card, F, fun _ hx => hx, rfl, fun _ => Iff.rfl⟩
  obtain ⟨G, sub, size, same⟩ := Nat.find_spec existsP
  refine ⟨G, sub, ?_, same⟩
  by_contra! large
  obtain ⟨a, b, c, ha, hb, hc, hab, hac, hbc⟩ := Finset.two_lt_card_iff.mp large
  have essential (x : S) (hx : x ∈ G) : ¬ Generates r G (G.erase x) := by
    intro remove
    have bound := Nat.find_min' existsP (show P (G.erase x).card from
      ⟨G.erase x, (Finset.erase_subset x G).trans sub, rfl, fun y => (same y).trans (remove y)⟩)
    have shorter := Finset.card_erase_lt_of_mem hx
    omega
  obtain ⟨u, au, ou⟩ := essential_at (essential a ha)
  obtain ⟨v, bv, ov⟩ := essential_at (essential b hb)
  obtain ⟨w, cw, ow⟩ := essential_at (essential c hc)
  exact none (six_from_rows au (ou b (by simp [hab.symm, hb])) (ou c (by simp [hac.symm, hc]))
    bv (ov a (by simp [hab, ha])) (ov c (by simp [hbc.symm, hc]))
    cw (ow a (by simp [hac, ha])) (ow b (by simp [hbc, hb])))

private theorem six_excludes_pair_basis {r : S → E → Prop} (s : Six r) : ¬ PairBasis r := by
  classical
  obtain ⟨a, b, reads⟩ := s
  intro basis
  let F := Finset.univ.image a
  obtain ⟨G, sub, small, same⟩ := basis F
  have inj : Function.Injective a := by
    intro i j hij
    by_contra ne
    have h := (reads i j).mpr ne
    rw [hij] at h
    exact ((reads j j).mp h) rfl
  have fsize : F.card = 3 := by simp [F, Finset.card_image_of_injective _ inj]
  obtain ⟨x, hx, xg⟩ := Finset.exists_mem_notMem_of_card_lt_card (s := G) (t := F) (by omega)
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
  have yes : Common r G (b i) := by
    intro y hy
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp (sub hy)
    exact (reads j i).mpr (by rintro rfl; exact xg hy)
  have no := (same (b i)).mpr yes (a i) (by simp [F])
  exact ((reads i i).mp no) rfl

/-- This concerns all native endpoints, and the representatives must be
members of the original launch family. No lattice or geometry is assumed. -/
theorem six_iff_no_pair_basis (r : S → E → Prop) : Six r ↔ ¬ PairBasis r := by
  classical
  exact ⟨six_excludes_pair_basis, fun hn => by
    by_contra missing
    exact hn (pair_basis_of_no_six missing)⟩

/-- A fixed same-content task may record more than arrival. For this
implication it suffices to prove that its original verdict is invariant under
every deletion preserving the complete common-future profile, and that no
deletion to two original launches preserves the verdict. -/
theorem six_of_grounded_role_deletion {r : S → E → Prop} {V : Type*}
    (outcome : Finset S → V) (F : Finset S)
    (grounded : ∀ G ⊆ F, Generates r F G → outcome F = outcome G)
    (required : ∀ G ⊆ F, G.card ≤ 2 → outcome F ≠ outcome G) : Six r := by
  apply (six_iff_no_pair_basis r).mpr
  intro basis
  obtain ⟨G, sub, small, same⟩ := basis F
  exact required G sub small (grounded G sub same)

/-- Three separate writes at times 0,1,2 can all be required by a final
three-label test. Their common future is already generated by the last write,
and no six-event reach pattern is possible on this serial time line. -/
theorem serial_three_writes :
    let r := fun (x : Fin 3) (t : ℕ) => x.val ≤ t
    Generates r Finset.univ {2} ∧
    (∀ G : Finset (Fin 3), G.card ≤ 2 → G ≠ Finset.univ) ∧ ¬ Six r := by
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · intro y
    constructor
    · intro h x _
      exact h x (Finset.mem_univ x)
    · intro h x _
      have h2 := h (2 : Fin 3) (by simp)
      fin_cases x <;> simp_all
      omega
  · rintro G small rfl
    simp at small
  · rintro ⟨a, b, reads⟩
    rcases le_total (a 0).val (a 1).val with ord | ord
    · have reaches := ord.trans ((reads 1 0).mpr (by decide))
      exact (reads 0 0).mp reaches rfl
    · have reaches := ord.trans ((reads 0 1).mpr (by decide))
      exact (reads 1 1).mp reaches rfl

section LatticeWindow
variable {L : Type*} [Lattice L]

/-- The one semidistributive identity used in the local observation window. -/
def JoinSemidistributive (L : Type*) [Lattice L] : Prop :=
  ∀ x y z : L, x ⊔ y = x ⊔ z → x ⊔ (y ⊓ z) = x ⊔ y

private theorem different_covers_join {x y p : L} (hxp : x ⋖ p) (hyp : y ⋖ p)
    (hxy : x ≠ y) : x ⊔ y = p := by
  have hn : ¬ y ≤ x := by
    intro h
    exact hyp.2 (lt_of_le_of_ne h hxy.symm) hxp.1
  have hlt : x < x ⊔ y := lt_of_le_of_ne le_sup_left (by
    intro he
    apply hn
    rw [he]
    exact le_sup_right)
  have hle : x ⊔ y ≤ p := sup_le hxp.1.le hyp.1.le
  exact eq_of_le_of_not_lt hle (hxp.2 hlt)

/-- Three distinct immediate predecessors of one occupied target produce all
six events when the local order has the displayed semidistributive law. The
map observes and reflects complete native reach on the window. -/
theorem six_of_three_lower_covers {r : E → E → Prop} (event : L → E)
    (exactReach : ∀ x y, r (event x) (event y) ↔ x ≤ y)
    (merge : JoinSemidistributive L)
    {p u v w : L} (hu : u ⋖ p) (hv : v ⋖ p) (hw : w ⋖ p)
    (huv : u ≠ v) (huw : u ≠ w) (hvw : v ≠ w) : Six r := by
  have diagonal {x y z : L} (hx : x ⋖ p) (hy : y ⋖ p) (hz : z ⋖ p)
      (hxy : x ≠ y) (hxz : x ≠ z) : ¬ r (event (y ⊓ z)) (event x) := by
    intro reached
    have below := (exactReach _ _).mp reached
    have xy := different_covers_join hx hy hxy
    have xz := different_covers_join hx hz hxz
    have collapse := merge x y z (xy.trans xz.symm)
    rw [sup_eq_left.mpr below, xy] at collapse
    exact hx.1.ne collapse
  exact six_from_rows (diagonal hu hv hw huv huw) ((exactReach _ _).mpr inf_le_left)
    ((exactReach _ _).mpr inf_le_left) (diagonal hv hu hw huv.symm hvw)
    ((exactReach _ _).mpr inf_le_left) ((exactReach _ _).mpr inf_le_right)
    (diagonal hw hu hv huw.symm hvw.symm) ((exactReach _ _).mpr inf_le_right)
    ((exactReach _ _).mpr inf_le_right)

/-- Finite families of genuine histories ordered by inclusion instantiate this
when their unions and intersections are represented by native events. -/
theorem distributivity_gives_merge_law {D : Type*} [DistribLattice D] :
    JoinSemidistributive D := by
  intro x y z he
  rw [sup_inf_left, ← he, inf_idem]

end LatticeWindow

section NativePast

/-- The profile uses every authorized path in `r`, independently of which
transmitters were enabled in any particular experiment. -/
def NativePast {K : Type*} (r : E → E → Prop) (origin : K → E) (y : E) : Set K :=
  {k | r (origin k) y}

structure LastProper {K : Type*} (allowed : Set (Set K)) (target past : Set K) : Prop where
  occupied : past ∈ allowed
  below : past ⊆ target
  missed : ∃ k ∈ target, k ∉ past
  maximal : ∀ B ∈ allowed, past ⊆ B → B ⊆ target → B = past ∨ B = target

private theorem two_last_cover_target {K : Type*} {A : Set (Set K)} {T U V : Set K}
    (hU : LastProper A T U) (hV : LastProper A T V) (ne : U ≠ V)
    (real : U ∪ V ∈ A) : U ∪ V = T := by
  rcases hU.maximal _ real Set.subset_union_left (Set.union_subset hU.below hV.below) with
    unchanged | done
  · have incl : V ⊆ U := unchanged ▸ Set.subset_union_right
    rcases hV.maximal U hU.occupied incl hU.below with eq | entire
    · exact (ne eq).elim
    · obtain ⟨x, xt, xu⟩ := hU.missed
      exact (xu (entire ▸ xt)).elim
  · exact done

/-- A single target with three distinct maximal proper native past profiles
forces all three exclusions when sibling profiles can be united within the
admitted family. No common predecessor representing an intersection is
assumed. A profile can be taken relative to any original source family. -/
theorem six_of_three_maximal_pasts {K : Type*} {r : E → E → Prop} (origin : K → E)
    (allowed : Set (Set K)) (p u v w : E)
    (hU : LastProper allowed (NativePast r origin p) (NativePast r origin u))
    (hV : LastProper allowed (NativePast r origin p) (NativePast r origin v))
    (hW : LastProper allowed (NativePast r origin p) (NativePast r origin w))
    (huv : NativePast r origin u ≠ NativePast r origin v)
    (huw : NativePast r origin u ≠ NativePast r origin w)
    (hvw : NativePast r origin v ≠ NativePast r origin w)
    (merge : ∀ X ∈ allowed, ∀ Y ∈ allowed,
      X ⊆ NativePast r origin p → Y ⊆ NativePast r origin p → X ∪ Y ∈ allowed) :
    Six r := by
  have uv := two_last_cover_target hU hV huv (merge _ hU.occupied _ hV.occupied hU.below hV.below)
  have uw := two_last_cover_target hU hW huw (merge _ hU.occupied _ hW.occupied hU.below hW.below)
  have vw := two_last_cover_target hV hW hvw (merge _ hV.occupied _ hW.occupied hV.below hW.below)
  obtain ⟨a, ap, au⟩ := hU.missed
  obtain ⟨b, bp, bv⟩ := hV.missed
  obtain ⟨c, cp, cw⟩ := hW.missed
  have other {X Y T : Set K} {x : K} (eq : X ∪ Y = T) (ht : x ∈ T) : x ∈ X ∨ x ∈ Y := by
    change x ∈ X ∪ Y
    rwa [eq]
  exact six_from_rows au ((other uv bp).resolve_right bv) ((other uw cp).resolve_right cw)
    bv ((other uv ap).resolve_left au) ((other vw cp).resolve_right cw)
    cw ((other uw ap).resolve_left au) ((other vw bp).resolve_left bv)

end NativePast
end AASCAccessDeletion
