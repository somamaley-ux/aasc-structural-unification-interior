    (``AASCKleinGordon.OperationalSR.occupied_radar_physical_units, #[``AASCKleinGordon.OperationalSR.occupied_radar_readings, ``AASCKleinGordon.OperationalSR.site_actual_reading]),
    (``AASCKleinGordon.OperationalSR.actual_directional_clock_readings_in_physical_units, #[``AASCKleinGordon.OperationalSR.directional_clock_actual_reading])]
  for (root, required) in roots do
    let mut seen : Std.HashSet Name := {}
    let mut todo := [root]
    while !todo.isEmpty do
      let name := todo.head!
      todo := todo.tail!
      if seen.contains name then continue
      seen := seen.insert name
      let some info := env.find? name | continue
      if let some value := info.value? true then
        for dep in value.getUsedConstants do
          unless seen.contains dep do todo := dep :: todo
    for name in required do
      unless seen.contains name do throwError "Missing actual operational-SR dependency {root} -> {name}"
    liftIO <| IO.println ("STAGE4_ROOT|" ++ (Json.mkObj [
      ("name", toJson root.toString), ("closure_count", toJson seen.size),
      ("required", toJson (required.map Name.toString))]).compress)
  for name in env.header.moduleNames do
    liftIO <| IO.println ("STAGE4_IMPORT|" ++ name.toString)
